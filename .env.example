# Server-side only. Never commit .env or data/.
AGENT_API_KEY=
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-5.1-codex-mini
# responses: native Responses API; chat: bridge Chat Completions to Codex Responses
AGENT_PROTOCOL=chat
PORT=3210
HOST=127.0.0.1
RUN_TIMEOUT_MS=600000
MAX_CONCURRENT_RUNS=2
# Optional for a nonstandard Codex install (native executable or bin/codex.js)
CODEX_BIN=
